{
	"name": "bento-cat",
	"private": true,
	"license": "AGPL-3.0-only",
	"version": "0.0.1",
	"type": "module",
	"engines": { "bun": ">=1.4.0" },
	"scripts": {
		"dev": "vite dev",
		"build": "bun --bun vite build",
		"start": "bun build/index.js",
		"test": "vitest run --config vitest.config.js",
		"test:watch": "vitest --config vitest.config.js",
		"check": "bun run test && bun run build",
		"check:production": "bun scripts/check-production.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"seed": "bun scripts/seed.mjs",
		"convex": "convex dev",
		"deploy:convex": "convex deploy"
	},
	"devDependencies": {
		"@sveltejs/adapter-bun": "1.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"convex-test": "^0.0.60",
		"svelte": "^5.56.7",
		"vite": "^8.3.0",
		"vitest": "^5.0.3"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@clerk/backend": "^3.22.0",
		"@clerk/clerk-js": "^6.37.0",
		"@fontsource-variable/instrument-sans": "^5.3.0",
		"convex": "^1.46.0",
		"maplibre-gl": "^6.12.0"
	}
}
